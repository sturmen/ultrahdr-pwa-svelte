{
  "name": "ultrahdr-pwa-svelte",
  "version": "5.1.1",
  "description": "A progressive webapp to encode UltraHDR images.",
  "homepage": "https://sturmen.github.io/ultrahdr-pwa-svelte",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app-version && npm run build:runtime-bundle-manifest && vite build",
    "build:app-version": "node scripts/build-app-version.js",
    "build:runtime-bundle-manifest": "node scripts/build-runtime-bundle-manifest.js",
    "build:wasm": "node scripts/build-wasm.js",
    "preview": "vite preview",
    "deploy": "npm run build:wasm && npm run build && gh-pages -d dist",
    "test": "vitest run --config vite.config.test.js",
    "test:e2e:chromium": "npx playwright test --project=chromium",
    "test:e2e": "npx playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:mobile": "npx playwright test --project=mobile-webkit-ios --project=mobile-chromium-android-gpu --project=mobile-chromium-android-fallback",
    "test:e2e:android-webgpu": "npx playwright test --config=playwright.android-real.config.js",
    "test:ui": "vitest run --ui",
    "test:integration:jpegli-determinism": "vitest run --config vite.config.jpegli-determinism.js",
    "test:coverage": "vitest run --config vite.config.test.js --coverage --coverage.provider=istanbul"
  },
  "keywords": [],
  "author": "Nicholas Tinsley",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "jszip": "^3.10.1",
    "libheif-js": "^1.19.8",
    "onnxruntime-web": "^1.24.2",
    "svelte": "^5.53.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-static-copy": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-istanbul": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "canvas": "^3.2.1",
    "gh-pages": "^6.3.0",
    "jsdom": "^28.1.0",
    "onnxruntime-node": "^1.24.2",
    "vitest": "^4.0.18"
  }
}
